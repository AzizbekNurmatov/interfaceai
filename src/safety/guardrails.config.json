{
  "allowedDomains": ["localhost:3000", "127.0.0.1:3000"],
  "blockedActionKeywords": [
    "DELETE",
    "WIRE_TRANSFER",
    "DROP",
    "TRUNCATE",
    "ACH_PUSH",
    "CLOSE_ACCOUNT"
  ],
  "sensitiveFieldMasking": {
    "fieldNames": [
      "password",
      "pwd",
      "txtpwd",
      "ssn",
      "tin",
      "pin",
      "cardnumber",
      "pan",
      "cvv",
      "accountnumber"
    ],
    "patterns": [
      {
        "name": "ssn",
        "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
        "replacement": "***-**-****"
      },
      {
        "name": "card",
        "regex": "\\b\\d{4}[- ]?\\d{4}[- ]?\\d{4}[- ]?\\d{4}\\b",
        "replacement": "****-****-****-****"
      }
    ]
  }
}
