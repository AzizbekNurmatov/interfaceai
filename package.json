{
  "name": "interfaceai",
  "version": "0.1.0",
  "description": "Deterministic computer-use automation for legacy banking applications lacking APIs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "discovery": "tsx src/discovery/index.ts",
    "replay": "tsx src/replay/cli.ts",
    "validate": "tsx src/schema/cli.ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "keywords": [
    "playwright",
    "computer-use",
    "banking",
    "automation"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.55.0"
  }
}
