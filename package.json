{
  "name": "interfaceai",
  "version": "0.1.0",
  "description": "Deterministic computer-use automation for legacy banking applications lacking APIs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "mock:server": "tsx src/server/index.ts",
    "discover": "tsx src/agent/index.ts",
    "replay": "tsx src/engine/cli.ts",
    "validate": "tsx src/schema/cli.ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:setup": "tsx src/server/sanity-check.ts"
  },
  "keywords": [
    "playwright",
    "computer-use",
    "banking",
    "automation"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.55.0",
    "zod": "^3.24.1"
  }
}
